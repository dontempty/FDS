&OBST ID='RAIL_FRONT', XB=-0.7500,0.7500,0.8750,1.0000,1.0000,1.1250, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='APILLAR_L', XB=-0.7500,-0.6250,0.8750,1.0000,1.0000,1.6250, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='BPILLAR_L', XB=-0.7500,-0.6250,-0.1250,0.1250,1.0000,1.6250, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='CPILLAR_L', XB=-0.7500,-0.6250,-1.0000,-0.8750,1.0000,1.6250, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='APILLAR_R', XB=0.6250,0.7500,0.8750,1.0000,1.0000,1.6250, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='BPILLAR_R', XB=0.6250,0.7500,-0.1250,0.1250,1.0000,1.6250, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='CPILLAR_R', XB=0.6250,0.7500,-1.0000,-0.8750,1.0000,1.6250, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='GLASS_WINDSHIELD', XB=-0.6250,0.6250,0.8750,1.0000,1.1250,1.5000, SURF_ID='CAR_GLASS', COLOR='SKY BLUE' /
&OBST ID='GLASS_BACKLIGHT', XB=-0.6250,0.6250,-1.0000,-0.8750,1.1250,1.5000, SURF_ID='CAR_GLASS', COLOR='SKY BLUE' /
&OBST ID='GLASS_FL', XB=-0.7500,-0.6250,0.1250,0.8750,1.3750,1.5000, SURF_ID='CAR_GLASS', COLOR='SKY BLUE' /
&OBST ID='GLASS_RL', XB=-0.7500,-0.6250,-0.8750,-0.1250,1.3750,1.5000, SURF_ID='CAR_GLASS', COLOR='SKY BLUE' /
&OBST ID='GLASS_FR', XB=0.6250,0.7500,0.1250,0.8750,1.1250,1.5000, SURF_ID='CAR_GLASS', COLOR='SKY BLUE' /
&OBST ID='GLASS_RR', XB=0.6250,0.7500,-0.8750,-0.1250,1.1250,1.5000, SURF_ID='CAR_GLASS', COLOR='SKY BLUE' /
&OBST ID='PACK', XB=-0.6250,0.6250,-0.7500,0.7500,0.2500,0.3750, SURF_ID='PACK_CASE', COLOR='GRAY 30' /   ! 연소하지 않음
! 하부 차체와 캐빈은 두께 0.125 m 판으로만 이루어져 내부가 비어 있다.
! 캐빈 프레임(루프+벨트레일 링+6개 필러)은 서로 맞닿아 하나로 연결된다.
! 좌측 앞·뒷 도어창은 하단을 내려 개구로 두었다 (논문 2.4절 half-opened).
! 팩 6면 전체에 벤트가스 경계조건. 팩은 지면·차체 어디에도 닿지 않게
! 띄워 두었으므로 6면이 모두 기체와 접한다.
&VENT XB=-0.6250,-0.6250,-0.7500,0.7500,0.2500,0.3750, SURF_ID='VENT_PACK' /   ! XMIN
&VENT XB=0.6250,0.6250,-0.7500,0.7500,0.2500,0.3750, SURF_ID='VENT_PACK' /   ! XMAX
&VENT XB=-0.6250,0.6250,-0.7500,-0.7500,0.2500,0.3750, SURF_ID='VENT_PACK' /   ! YMIN
&VENT XB=-0.6250,0.6250,0.7500,0.7500,0.2500,0.3750, SURF_ID='VENT_PACK' /   ! YMAX
&VENT XB=-0.6250,0.6250,-0.7500,0.7500,0.2500,0.2500, SURF_ID='VENT_PACK' /   ! ZMIN
&VENT XB=-0.6250,0.6250,-0.7500,0.7500,0.3750,0.3750, SURF_ID='VENT_PACK' /   ! ZMAX

&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /
&VENT MB='ZMIN', SURF_ID='GROUND' /

! ========================================================================
!  센서 - 논문 Fig. 4(b)~(e) 위치 그대로
! ========================================================================
! 천장 수냉파이프 열전대 (z = 2.270 m)
&DEVC ID='TC_GB', QUANTITY='THERMOCOUPLE', XYZ=0.000,1.490,2.270 /
&DEVC ID='TC_GW', QUANTITY='THERMOCOUPLE', XYZ=0.000,0.690,2.270 /
&DEVC ID='TC_GFW', QUANTITY='THERMOCOUPLE', XYZ=-0.660,0.130,2.270 /
&DEVC ID='TC_GR', QUANTITY='THERMOCOUPLE', XYZ=0.000,-0.510,2.270 /
&DEVC ID='TC_GRW', QUANTITY='THERMOCOUPLE', XYZ=-0.660,-0.670,2.270 /
&DEVC ID='TC_GCRW', QUANTITY='THERMOCOUPLE', XYZ=0.000,-1.710,2.270 /
! 도어창 중앙높이 열전대 (z = 1.270 m)
&DEVC ID='TC_FW', QUANTITY='THERMOCOUPLE', XYZ=-0.660,0.130,1.270 /
&DEVC ID='TC_RW', QUANTITY='THERMOCOUPLE', XYZ=-0.660,-0.670,1.270 /
! Schmidt-Boelter 열유속계 4개. RADIOMETER/GAUGE HEAT FLUX 는 FDS에서
! 고체상 quantity라 벽면이 있어야 한다 (없으면 ERROR(427)). 실제 게이지도
! 수냉 몸체이므로 1셀 블록을 세우고 차량을 향한 면에 붙였다.
!   <id>     = RADIOMETER      (복사만. 논문 'irradiance')
!   <id>_tot = GAUGE HEAT FLUX (복사+대류. Schmidt-Boelter 실측 대응)
&OBST ID='BODY_HF_F', XB=0.0000,0.1250,2.6250,2.7500,1.2500,1.3750, SURF_ID='HF_GAUGE', COLOR='BLUE' /
&DEVC ID='HF_F', QUANTITY='RADIOMETER', XYZ=0.0000,2.5625,1.2500, IOR=-2 /
&DEVC ID='HF_F_tot', QUANTITY='GAUGE HEAT FLUX', XYZ=0.0000,2.5625,1.2500, IOR=-2 /
&OBST ID='BODY_HF_R', XB=0.0000,0.1250,-2.7500,-2.6250,1.2500,1.3750, SURF_ID='HF_GAUGE', COLOR='BLUE' /
&DEVC ID='HF_R', QUANTITY='RADIOMETER', XYZ=0.0000,-2.5625,1.2500, IOR=+2 /
&DEVC ID='HF_R_tot', QUANTITY='GAUGE HEAT FLUX', XYZ=0.0000,-2.5625,1.2500, IOR=+2 /
&OBST ID='BODY_HF_FD', XB=-1.6250,-1.5000,0.0000,0.2500,1.2500,1.3750, SURF_ID='HF_GAUGE', COLOR='BLUE' /
&DEVC ID='HF_FD', QUANTITY='RADIOMETER', XYZ=-1.4375,0.1250,1.2500, IOR=+1 /
&DEVC ID='HF_FD_tot', QUANTITY='GAUGE HEAT FLUX', XYZ=-1.4375,0.1250,1.2500, IOR=+1 /
&OBST ID='BODY_HF_RD', XB=-1.6250,-1.5000,-0.7500,-0.5000,1.2500,1.3750, SURF_ID='HF_GAUGE', COLOR='BLUE' /
&DEVC ID='HF_RD', QUANTITY='RADIOMETER', XYZ=-1.4375,-0.6250,1.2500, IOR=+1 /
&DEVC ID='HF_RD_tot', QUANTITY='GAUGE HEAT FLUX', XYZ=-1.4375,-0.6250,1.2500, IOR=+1 /

! 반응별 HRR 분리 (논문 Test 1 팩 vs Test 2 차체 기여 대조)
&DEVC ID='HRR_BATT', QUANTITY='HRRPUV REAC', REAC_ID='BATT', SPATIAL_STATISTIC='VOLUME INTEGRAL', XB=-4.0000,4.0000,-5.0000,5.0000,0.0000,6.0000 /
&DEVC ID='HRR_BODY', QUANTITY='HRRPUV REAC', REAC_ID='BODY', SPATIAL_STATISTIC='VOLUME INTEGRAL', XB=-4.0000,4.0000,-5.0000,5.0000,0.0000,6.0000 /

! 팩 표면 열유속 (1D 되먹임용)
&DEVC ID='q_PACK_BOT', QUANTITY='GAUGE HEAT FLUX', XB=-0.6250,0.6250,-0.7500,0.7500,0.2500,0.2500, IOR=-3, SPATIAL_STATISTIC='MEAN' /
&DEVC ID='T_PACK_BOT', QUANTITY='WALL TEMPERATURE', XB=-0.6250,0.6250,-0.7500,0.7500,0.2500,0.2500, IOR=-3, SPATIAL_STATISTIC='MEAN' /
&DEVC ID='q_PACK_XMIN', QUANTITY='GAUGE HEAT FLUX', XB=-0.6250,-0.6250,-0.7500,0.7500,0.2500,0.3750, IOR=-1, SPATIAL_STATISTIC='MEAN' /
&DEVC ID='T_PACK_XMIN', QUANTITY='WALL TEMPERATURE', XB=-0.6250,-0.6250,-0.7500,0.7500,0.2500,0.3750, IOR=-1, SPATIAL_STATISTIC='MEAN' /
&DEVC ID='q_PACK_XMAX', QUANTITY='GAUGE HEAT FLUX', XB=0.6250,0.6250,-0.7500,0.7500,0.2500,0.3750, IOR=1, SPATIAL_STATISTIC='MEAN' /
&DEVC ID='T_PACK_XMAX', QUANTITY='WALL TEMPERATURE', XB=0.6250,0.6250,-0.7500,0.7500,0.2500,0.3750, IOR=1, SPATIAL_STATISTIC='MEAN' /

&BNDF QUANTITY='GAUGE HEAT FLUX' /
&BNDF QUANTITY='WALL TEMPERATURE' /
&BNDF QUANTITY='BURNING RATE' /

! vehicle centreline (x=0)
&SLCF PBX=0.0000, QUANTITY='TEMPERATURE' /
&SLCF PBX=0.0000, QUANTITY='HRRPUV' /
&SLCF PBX=0.0000, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN' /
&SLCF PBX=0.0000, QUANTITY='MASS FRACTION', SPEC_ID='BATTERY_GAS' /
! vehicle centre (y=0)
&SLCF PBY=0.0000, QUANTITY='TEMPERATURE' /
&SLCF PBY=0.0000, QUANTITY='HRRPUV' /
! pack mid-height (under-body vent jets)
&SLCF PBZ=0.2500, QUANTITY='TEMPERATURE' /
&SLCF PBZ=0.2500, QUANTITY='HRRPUV' /
! ceiling TC level z=2.27 m
&SLCF PBZ=2.2500, QUANTITY='TEMPERATURE' /
&ISOF QUANTITY='HRRPUV', VALUE(1)=100. /

&TAIL /
