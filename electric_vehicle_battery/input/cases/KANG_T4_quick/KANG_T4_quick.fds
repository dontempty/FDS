&RAMP ID='hrr_pack', T=  4082.243, F=0.02033 /
&RAMP ID='hrr_pack', T=  4183.178, F=0.00004 /

! ========================================================================
!  지오메트리 - 타이어 -> 하부 차체(속 빈 쉘) -> 캐빈(프레임+유리)
! ========================================================================
&OBST ID='TIRE_RL', XB=-0.8750,-0.6250,-1.6250,-1.0000,0.0000,0.6250, SURF_ID='TIRE', COLOR='BLACK' /
&OBST ID='TIRE_RR', XB=0.6250,0.8750,-1.6250,-1.0000,0.0000,0.6250, SURF_ID='TIRE', COLOR='BLACK' /
&OBST ID='TIRE_FL', XB=-0.8750,-0.6250,1.0000,1.6250,0.0000,0.6250, SURF_ID='TIRE', COLOR='BLACK' /
&OBST ID='TIRE_FR', XB=0.6250,0.8750,1.0000,1.6250,0.0000,0.6250, SURF_ID='TIRE', COLOR='BLACK' /
&OBST ID='FLOOR_1', XB=-0.8750,0.8750,-2.1250,-1.6250,0.5000,0.6250, SURF_ID='CAR_BODY', COLOR='GRAY 60' /
&OBST ID='SIDE_L_1', XB=-0.8750,-0.7500,-2.1250,-1.6250,0.5000,1.0000, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='SIDE_R_1', XB=0.7500,0.8750,-2.1250,-1.6250,0.5000,1.0000, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='FLOOR_2', XB=-0.8750,0.8750,-1.0000,1.0000,0.5000,0.6250, SURF_ID='CAR_BODY', COLOR='GRAY 60' /
&OBST ID='SIDE_L_2', XB=-0.8750,-0.7500,-1.0000,1.0000,0.5000,1.0000, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='SIDE_R_2', XB=0.7500,0.8750,-1.0000,1.0000,0.5000,1.0000, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='FLOOR_3', XB=-0.8750,0.8750,1.6250,2.1250,0.5000,0.6250, SURF_ID='CAR_BODY', COLOR='GRAY 60' /
&OBST ID='SIDE_L_3', XB=-0.8750,-0.7500,1.6250,2.1250,0.5000,1.0000, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='SIDE_R_3', XB=0.7500,0.8750,1.6250,2.1250,0.5000,1.0000, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='FLOOR_ARCH_1', XB=-0.6250,0.6250,-1.6250,-1.0000,0.5000,0.6250, SURF_ID='CAR_BODY', COLOR='GRAY 60' /
&OBST ID='SIDE_L_ARCH_1', XB=-0.8750,-0.7500,-1.6250,-1.0000,0.6250,1.0000, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='SIDE_R_ARCH_1', XB=0.7500,0.8750,-1.6250,-1.0000,0.6250,1.0000, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='FLOOR_ARCH_2', XB=-0.6250,0.6250,1.0000,1.6250,0.5000,0.6250, SURF_ID='CAR_BODY', COLOR='GRAY 60' /
&OBST ID='SIDE_L_ARCH_2', XB=-0.8750,-0.7500,1.0000,1.6250,0.6250,1.0000, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='SIDE_R_ARCH_2', XB=0.7500,0.8750,1.0000,1.6250,0.6250,1.0000, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='END_REAR', XB=-0.8750,0.8750,-2.1250,-2.0000,0.5000,1.0000, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='END_FRONT', XB=-0.8750,0.8750,2.0000,2.1250,0.5000,1.0000, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='HOOD', XB=-0.8750,0.8750,0.8750,2.1250,0.8750,1.0000, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='TRUNK', XB=-0.8750,0.8750,-2.1250,-0.8750,0.8750,1.0000, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='SILL_L', XB=-0.8750,-0.6250,-1.0000,1.0000,0.8750,1.0000, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='SILL_R', XB=0.6250,0.8750,-1.0000,1.0000,0.8750,1.0000, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='ROOF', XB=-0.7500,0.7500,-1.0000,1.0000,1.5000,1.6250, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='RAIL_L', XB=-0.7500,-0.6250,-1.0000,1.0000,1.0000,1.1250, SURF_ID='CAR_BODY', COLOR='SILVER' /
&OBST ID='RAIL_R', XB=0.6250,0.7500,-1.0000,1.0000,1.0000,1.1250, SURF_ID='CAR_BODY', COLOR='SILVER' /
