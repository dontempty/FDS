&HEAD CHID='KANG_T4_quick', TITLE='Kang et al. Test 4 - smoke test' /
! 생성: input/build_kang_validation.ipynb (수동 편집 금지)
! 검증 대상: Kang et al., Applied Energy 332 (2023) 120497, Test 4 (BEV_3, 64 kWh)
! 좌표계: x=폭, y=길이(후->전), z=플랫폼 상면 기준.
!         차량 중심이 원점 (0,0). 논문 좌표에서 (-1.550, -2.600) m 평행이동.

! ========================================================================
!  메쉬 · 시간 · 출력
! ========================================================================
&MESH ID='M01', IJK=29,39,48, XB=-4.0000,-0.3750, -5.0000,-0.1250, 0.0000,6.0000 /
&MESH ID='M02', IJK=29,41,48, XB=-4.0000,-0.3750, -0.1250,5.0000, 0.0000,6.0000 /
&MESH ID='M03', IJK=35,39,48, XB=-0.3750,4.0000, -5.0000,-0.1250, 0.0000,6.0000 /
&MESH ID='M04', IJK=35,41,48, XB=-0.3750,4.0000, -0.1250,5.0000, 0.0000,6.0000 /
! 메쉬 경계면: x=[-0.375], y=[-0.125], z=[]
&TIME T_END=300.0 /
&MISC TMPA=20.0 /
&DUMP DT_HRR=1.0, DT_DEVC=1.0, DT_SLCF=5.0, DT_BNDF=20.0, MASS_FILE=T /   ! MASS_FILE = 논문 로드셀 대응

! ========================================================================
!  화학종
! ========================================================================
&SPEC ID='HYDROGEN'          LUMPED_COMPONENT_ONLY=T /
&SPEC ID='CARBON MONOXIDE'   LUMPED_COMPONENT_ONLY=T /
&SPEC ID='CARBON DIOXIDE'    LUMPED_COMPONENT_ONLY=T /
&SPEC ID='METHANE'           LUMPED_COMPONENT_ONLY=T /
&SPEC ID='ETHYLENE'          LUMPED_COMPONENT_ONLY=T /
&SPEC ID='BATTERY_GAS',
      SPEC_ID(1)='HYDROGEN', VOLUME_FRACTION(1)=28.000,
      SPEC_ID(2)='CARBON MONOXIDE', VOLUME_FRACTION(2)=23.000,
      SPEC_ID(3)='CARBON DIOXIDE', VOLUME_FRACTION(3)=28.000,
      SPEC_ID(4)='METHANE', VOLUME_FRACTION(4)=12.000,
      SPEC_ID(5)='ETHYLENE', VOLUME_FRACTION(5)=9.000 /
&SPEC ID='CAR_BODY_FUEL', FORMULA='C6H10O1' /
&SPEC ID='HYDROGEN FLUORIDE' /   ! 비반응 추적

! ========================================================================
!  반응
! ========================================================================
&REAC ID='BATT', FUEL='BATTERY_GAS', HEAT_OF_COMBUSTION=14644.3,
      SOOT_YIELD=0.02, CO_YIELD=0.05, RADIATIVE_FRACTION=0.15 /
&REAC ID='BODY', FUEL='CAR_BODY_FUEL', HEAT_OF_COMBUSTION=28800.0,   ! Table 6 실측
      SOOT_YIELD=0.1, CO_YIELD=0.05, RADIATIVE_FRACTION=0.35 /

! ========================================================================
!  부품별 재료 - 프레임 / 타이어 / 유리 를 독립 파라미터로 둔다
! ========================================================================
! 프레임과 타이어는 열적 물성만 다르고 연료 화학종은 CAR_BODY_FUEL 로
! 공유한다 (REAC 를 늘리지 않기 위해서). THICKNESS 는 각자 질량에서 역산.
&MATL ID='FRAME_MATL'
      SPEC_ID='CAR_BODY_FUEL'
      NU_SPEC=1.0
      BOILING_TEMPERATURE=380.0
      HEAT_OF_REACTION=1800.0
      DENSITY=900.0
      CONDUCTIVITY=0.2
      SPECIFIC_HEAT=1.5
      ABSORPTION_COEFFICIENT=1000.0
      EMISSIVITY=0.9 /
&MATL ID='TIRE_MATL'
      SPEC_ID='CAR_BODY_FUEL'
      NU_SPEC=1.0
      BOILING_TEMPERATURE=420.0
      HEAT_OF_REACTION=2200.0
      DENSITY=1100.0
      CONDUCTIVITY=0.25
      SPECIFIC_HEAT=1.8
      ABSORPTION_COEFFICIENT=1000.0
      EMISSIVITY=0.95 /
! 유리는 비연소. 형상에서 빼지 않고 이 SURF 로 채워 두었으므로,
! 물성을 바꾸면 캐빈 열적 거동만 독립으로 손볼 수 있다.
&MATL ID='GLASS_MATL'
      DENSITY=2500.0
      CONDUCTIVITY=1.05
      SPECIFIC_HEAT=0.84
      EMISSIVITY=0.9 /
&SURF ID='CAR_BODY',  MATL_ID='FRAME_MATL', THICKNESS=0.00638, COLOR='SILVER' /
&SURF ID='TIRE',      MATL_ID='TIRE_MATL',  THICKNESS=0.00882, COLOR='BLACK' /
&SURF ID='CAR_GLASS', MATL_ID='GLASS_MATL', THICKNESS=0.00600, COLOR='SKY BLUE' /
&SURF ID='GROUND', COLOR='GRAY 40' /
! Schmidt-Boelter 게이지는 수냉식이라 표면이 상온에 가깝게 유지된다.
&SURF ID='HF_GAUGE', TMP_FRONT=20.0, COLOR='BLUE' /

! ========================================================================
!  경로 1 - 팩 케이싱 고체 경계조건
! ========================================================================
&SURF ID='PACK_CASE', COLOR='GRAY 30', NET_HEAT_FLUX=5.0000, RAMP_Q='cas_q' /
&RAMP ID='cas_q', T=     0.000, F=0.00000 /
&RAMP ID='cas_q', T=   300.000, F=0.30000 /
&RAMP ID='cas_q', T=   600.000, F=0.80000 /
&RAMP ID='cas_q', T=   900.000, F=1.00000 /

! ========================================================================
!  경로 2 - 팩 발열률. ref_data 실측곡선을 팩 6면에 면적비례로
! ========================================================================
! 소스: ref_data/pack_HRR.csv  (t[min], HRR[MW]) 를 선형보간
! 6면 합 면적 A = 4.4375 m2 (XMIN, XMAX, YMIN, YMAX, ZMIN, ZMAX)
! pHRR 1.520 MW @ 18.5 min,  THR 1.318 GJ,  HRRPUA = pHRR/A = 342.43 kW/m2
! 6면 합 = HRRPUA x A x RAMP_Q(t) = 곡선값. 면적비례는 자동으로 성립한다.
&SURF ID='VENT_PACK', COLOR='ORANGE',
      HRRPUA=342.4266, RAMP_Q='hrr_pack',
      SPEC_ID(1)='BATTERY_GAS', MASS_FRACTION(1)=0.995000,
      SPEC_ID(2)='HYDROGEN FLUORIDE', MASS_FRACTION(2)=0.005000,
      TMP_FRONT=660.0 /
&RAMP ID='hrr_pack', T=     0.000, F=0.04004 /
&RAMP ID='hrr_pack', T=    84.112, F=0.10006 /
&RAMP ID='hrr_pack', T=   145.794, F=0.09992 /
&RAMP ID='hrr_pack', T=   207.477, F=0.11982 /
&RAMP ID='hrr_pack', T=   263.551, F=0.11969 /
&RAMP ID='hrr_pack', T=   325.234, F=0.16967 /
&RAMP ID='hrr_pack', T=   370.093, F=0.09938 /
&RAMP ID='hrr_pack', T=   426.168, F=0.07919 /
&RAMP ID='hrr_pack', T=   543.925, F=0.10899 /
&RAMP ID='hrr_pack', T=   571.963, F=0.13901 /
