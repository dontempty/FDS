&HEAD CHID='grid_mesh5_759808', TITLE='Marine engine-room fire (Lan et al. 2023, Fig 1)' /

! ============================================================
! Room    : 13.0 × 10.0 × 3.0 m  (x[0.0,13.0] y[0.0,10.0] z[0.0,3.0])
! Fire   : floor VENT x=[7.9,8.9]  y=[1.0,2.0]  z=0  (1.00 m², peak HRR=863 kW, HRRPUA=863.0 kW/m²)
! Cells  : 182 × 140 × 42 = 1,070,160
! Split  : 2 × 7 × 2 = 28 sub-mesh(es) → MPI ranks
! dx=0.0714 dy=0.0714 dz=0.0714 m
! Equipment (3):
!   main_engine                  x=[3.5,10.0] y=[5.0,8.8] z=[0.0,2.0]
!   fuel_oil_supply              x=[4.5,6.5] y=[3.2,4.2] z=[0.0,1.0]
!   preheater                    x=[11.5,11.7] y=[4.5,5.5] z=[0.0,0.5]
! Walls (12):
!   outer_west                   x=[0.0,0.2] y=[0.0,10.0] z=[0.0,3.0]
!   outer_east                   x=[12.8,13.0] y=[0.0,10.0] z=[0.0,3.0]
!   outer_south                  x=[0.0,13.0] y=[0.0,0.2] z=[0.0,3.0]
!   outer_north                  x=[0.0,13.0] y=[9.8,10.0] z=[0.0,3.0]
!   east_rooms_1to3              x=[2.3,2.5] y=[4.2,9.3] z=[0.0,3.0]
!   east_rooms_4_5               x=[3.8,4.0] y=[0.2,4.0] z=[0.0,3.0]
!   h_top_room1                  x=[0.0,2.5] y=[9.3,9.5] z=[0.0,3.0]
!   h_room1_room2                x=[0.0,2.5] y=[7.3,7.5] z=[0.0,3.0]
!   h_room2_room3                x=[0.0,2.5] y=[5.8,6.0] z=[0.0,3.0]
!   h_room3_room4                x=[0.0,4.0] y=[4.0,4.2] z=[0.0,3.0]
!   h_room4_room5                x=[0.0,4.0] y=[2.3,2.5] z=[0.0,3.0]
!   osr_north_wall               x=[4.0,12.8] y=[2.8,3.0] z=[0.0,3.0]
! Doors as HOLEs (2):
!   door1_main_to_room1          x=[2.2,2.6] y=[8.2,9.1] z=[0.0,2.0]
!   door2_main_to_osr            x=[7.7,8.7] y=[2.7,3.1] z=[0.0,2.0]
! Doors to outside (partial OPEN vents) (0):
! ============================================================

! Multi-mesh: each sub-mesh 91×20×21 = 38,220 cells.
&MULT ID='m1', DX=6.5, DY=1.4285714285714286, DZ=1.5, I_LOWER=0, I_UPPER=1, J_LOWER=0, J_UPPER=6, K_LOWER=0, K_UPPER=1 /
&MESH IJK=91,20,21, XB=0.0,6.5,0.0,1.4285714285714286,0.0,1.5, MULT_ID='m1' /

&TIME T_END=300.0 /
&MISC TMPA=20.0 /  ! ambient cabin air (paper Table 3, T=293 K)
&DUMP DT_DEVC=1.0, DT_HRR=1.0, DT_SLCF=10.0, DT_BNDF=30.0, SMOKE3D=.FALSE., MASS_FILE=.TRUE. /

&REAC FUEL='N-HEPTANE', HEAT_OF_COMBUSTION=42600, RADIATIVE_FRACTION=0.3, SOOT_YIELD=0.05, CO_YIELD=0.02 /
&RADI KAPPA0=1.7 /  ! constant absorption coefficient (paper Table 2)

! All 6 outer faces solid by default; doors below are explicit openings.

! HVAC vents — Method 2, v=1.0 m/s normal velocity
&SURF ID='vent_intake',  VEL=-1.0, COLOR='GREEN', TMP_FRONT=20.0 /
&SURF ID='vent_exhaust', VEL=1.0,  COLOR='BLUE' /
&VENT XB=12.200000000000001,12.8,0.2,0.2,2.4,3.0, SURF_ID='vent_intake' /  ! inlet_01 (intake on outer_south)
&VENT XB=4.0,4.6,0.2,0.2,2.4,3.0, SURF_ID='vent_intake' /  ! inlet_02 (intake on outer_south)
&VENT XB=12.200000000000001,12.8,3.0,3.0,2.4,3.0, SURF_ID='vent_intake' /  ! inlet_03 (intake on osr_north_wall)
&VENT XB=4.0,4.6,3.0,3.0,2.4,3.0, SURF_ID='vent_intake' /  ! inlet_04 (intake on osr_north_wall)
&VENT XB=12.200000000000001,12.8,2.8,2.8,0.0,0.6, SURF_ID='vent_exhaust' /  ! outlet_01 (exhaust on osr_north)
&VENT XB=4.0,4.6,2.8,2.8,0.0,0.6, SURF_ID='vent_exhaust' /  ! outlet_02 (exhaust on osr_north)
&VENT XB=12.200000000000001,12.8,9.8,9.8,0.0,0.6, SURF_ID='vent_exhaust' /  ! outlet_03 (exhaust on outer_north)
&VENT XB=4.0,4.6,9.8,9.8,0.0,0.6, SURF_ID='vent_exhaust' /  ! outlet_04 (exhaust on outer_north)

! Fire HRR ramp (normalized to peak)
&RAMP ID='fire_hrr', T=0.000, F=0.000000 /
&RAMP ID='fire_hrr', T=1.034, F=0.001189 /
&RAMP ID='fire_hrr', T=2.069, F=0.004756 /
&RAMP ID='fire_hrr', T=3.103, F=0.010702 /
&RAMP ID='fire_hrr', T=4.138, F=0.019025 /
&RAMP ID='fire_hrr', T=5.172, F=0.029727 /
&RAMP ID='fire_hrr', T=6.207, F=0.042806 /
&RAMP ID='fire_hrr', T=7.241, F=0.058264 /
&RAMP ID='fire_hrr', T=8.276, F=0.076100 /
&RAMP ID='fire_hrr', T=9.310, F=0.096314 /
&RAMP ID='fire_hrr', T=10.345, F=0.118906 /
&RAMP ID='fire_hrr', T=11.379, F=0.143876 /
&RAMP ID='fire_hrr', T=12.414, F=0.171225 /
&RAMP ID='fire_hrr', T=13.448, F=0.200951 /
&RAMP ID='fire_hrr', T=14.483, F=0.233056 /
&RAMP ID='fire_hrr', T=15.517, F=0.267539 /
&RAMP ID='fire_hrr', T=16.552, F=0.304400 /
&RAMP ID='fire_hrr', T=17.586, F=0.343639 /
&RAMP ID='fire_hrr', T=18.621, F=0.385256 /
&RAMP ID='fire_hrr', T=19.655, F=0.429251 /
&RAMP ID='fire_hrr', T=20.690, F=0.475624 /
&RAMP ID='fire_hrr', T=21.724, F=0.524376 /
&RAMP ID='fire_hrr', T=22.759, F=0.575505 /
&RAMP ID='fire_hrr', T=23.793, F=0.629013 /
&RAMP ID='fire_hrr', T=24.828, F=0.684899 /
&RAMP ID='fire_hrr', T=25.862, F=0.743163 /
&RAMP ID='fire_hrr', T=26.897, F=0.803805 /
&RAMP ID='fire_hrr', T=27.931, F=0.866825 /
&RAMP ID='fire_hrr', T=28.966, F=0.932224 /
&RAMP ID='fire_hrr', T=30.000, F=1.000000 /
&RAMP ID='fire_hrr', T=300.000, F=1.000000 /

! Steel material (Lan et al. 2023, Table 1)
&MATL ID='STEEL', DENSITY=7850.0, SPECIFIC_HEAT=0.46, CONDUCTIVITY=45.8, EMISSIVITY=0.95 /

&SURF ID='surf_wall_white', MATL_ID='STEEL', THICKNESS=0.2, BACKING='EXPOSED', COLOR='WHITE' /
&SURF ID='surf_floor_ceiling', MATL_ID='STEEL', THICKNESS=0.01, BACKING='INSULATED', COLOR='GRAY', DEFAULT=.TRUE. /
&SURF ID='surf_eq_purple', MATL_ID='STEEL', THICKNESS=0.01, BACKING='INSULATED', COLOR='PURPLE' /
&SURF ID='fire', COLOR='RED', HRRPUA=863.000, RAMP_Q='fire_hrr', TMP_FRONT=400. /

! 12 internal walls (rooms partition) -- only osr_north_wall is steel, rest are INERT
&OBST XB=0.0,0.2,0.0,10.0,0.0,3.0, SURF_ID='INERT' /  ! wall: outer_west
&OBST XB=12.8,13.0,0.0,10.0,0.0,3.0, SURF_ID='INERT' /  ! wall: outer_east
&OBST XB=0.0,13.0,0.0,0.2,0.0,3.0, SURF_ID='INERT' /  ! wall: outer_south
&OBST XB=0.0,13.0,9.8,10.0,0.0,3.0, SURF_ID='INERT' /  ! wall: outer_north
&OBST XB=2.3,2.5,4.2,9.3,0.0,3.0, SURF_ID='INERT' /  ! wall: east_rooms_1to3
&OBST XB=3.8,4.0,0.2,4.0,0.0,3.0, SURF_ID='INERT' /  ! wall: east_rooms_4_5
&OBST XB=0.0,2.5,9.3,9.5,0.0,3.0, SURF_ID='INERT' /  ! wall: h_top_room1
&OBST XB=0.0,2.5,7.3,7.5,0.0,3.0, SURF_ID='INERT' /  ! wall: h_room1_room2
&OBST XB=0.0,2.5,5.8,6.0,0.0,3.0, SURF_ID='INERT' /  ! wall: h_room2_room3
&OBST XB=0.0,4.0,4.0,4.2,0.0,3.0, SURF_ID='INERT' /  ! wall: h_room3_room4
&OBST XB=0.0,4.0,2.3,2.5,0.0,3.0, SURF_ID='INERT' /  ! wall: h_room4_room5
&OBST XB=4.0,12.8,2.8,3.0,0.0,3.0, SURF_ID='surf_wall_white' /  ! wall: osr_north_wall

! 2 door openings (&HOLE removes wall cells)
&HOLE XB=2.2,2.6,8.2,9.1,0.0,2.0 /  ! door: door1_main_to_room1
&HOLE XB=7.7,8.7,2.7,3.1,0.0,2.0 /  ! door: door2_main_to_osr

! 3 equipment OBSTs from Fig 1 -- steel shell
&OBST XB=3.5,10.0,5.0,8.8,0.0,2.0, SURF_ID='surf_eq_purple' /  ! main_engine
&OBST XB=4.5,6.5,3.2,4.2,0.0,1.0, SURF_ID='surf_eq_purple' /  ! fuel_oil_supply
&OBST XB=11.5,11.7,4.5,5.5,0.0,0.5, SURF_ID='surf_eq_purple' /  ! preheater

&VENT XB=7.9,8.9,1.0,2.0,0,0, SURF_ID='fire' /  ! fire footprint

! Centerline above fire: x=8.400, y=1.500, z=[0.050..3.0]
&PROP ID='TC', TIME_CONSTANT=3 /
&DEVC ID='line_thermocouple', XB=8.4000,8.4000,1.5000,1.5000,0.0500,3.0000, POINTS=30, QUANTITY='THERMOCOUPLE', PROP_ID='TC', Z_ID='Height' /
&DEVC ID='line_temperature', XB=8.4000,8.4000,1.5000,1.5000,0.0500,3.0000, POINTS=30, QUANTITY='TEMPERATURE', HIDE_COORDINATES=.TRUE. /
&DEVC ID='line_w_velocity', XB=8.4000,8.4000,1.5000,1.5000,0.0500,3.0000, POINTS=30, QUANTITY='W-VELOCITY', HIDE_COORDINATES=.TRUE. /
&DEVC ID='line_velocity', XB=8.4000,8.4000,1.5000,1.5000,0.0500,3.0000, POINTS=30, QUANTITY='VELOCITY', HIDE_COORDINATES=.TRUE. /
&DEVC ID='line_hrrpuv', XB=8.4000,8.4000,1.5000,1.5000,0.0500,3.0000, POINTS=30, QUANTITY='HRRPUV', HIDE_COORDINATES=.TRUE. /
&DEVC ID='line_visibility', XB=8.4000,8.4000,1.5000,1.5000,0.0500,3.0000, POINTS=30, QUANTITY='VISIBILITY', HIDE_COORDINATES=.TRUE. /
&DEVC ID='line_volume_fraction_carbon_monoxide', XB=8.4000,8.4000,1.5000,1.5000,0.0500,3.0000, POINTS=30, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE', HIDE_COORDINATES=.TRUE. /
&DEVC ID='line_volume_fraction_soot', XB=8.4000,8.4000,1.5000,1.5000,0.0500,3.0000, POINTS=30, QUANTITY='VOLUME FRACTION', SPEC_ID='SOOT', HIDE_COORDINATES=.TRUE. /
&DEVC ID='line_volume_fraction_oxygen', XB=8.4000,8.4000,1.5000,1.5000,0.0500,3.0000, POINTS=30, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN', HIDE_COORDINATES=.TRUE. /
! 10 single-point DEVCs at evenly-spaced heights
&DEVC ID='pt_thermocouple_z0p05', XYZ=8.4000,1.5000,0.0500, QUANTITY='THERMOCOUPLE', PROP_ID='TC' /
&DEVC ID='pt_temperature_z0p05', XYZ=8.4000,1.5000,0.0500, QUANTITY='TEMPERATURE' /
&DEVC ID='pt_w_velocity_z0p05', XYZ=8.4000,1.5000,0.0500, QUANTITY='W-VELOCITY' /
&DEVC ID='pt_velocity_z0p05', XYZ=8.4000,1.5000,0.0500, QUANTITY='VELOCITY' /
&DEVC ID='pt_hrrpuv_z0p05', XYZ=8.4000,1.5000,0.0500, QUANTITY='HRRPUV' /
&DEVC ID='pt_visibility_z0p05', XYZ=8.4000,1.5000,0.0500, QUANTITY='VISIBILITY' /
&DEVC ID='pt_volume_fraction_carbon_monoxide_z0p05', XYZ=8.4000,1.5000,0.0500, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /
&DEVC ID='pt_volume_fraction_soot_z0p05', XYZ=8.4000,1.5000,0.0500, QUANTITY='VOLUME FRACTION', SPEC_ID='SOOT' /
&DEVC ID='pt_volume_fraction_oxygen_z0p05', XYZ=8.4000,1.5000,0.0500, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN' /
&DEVC ID='pt_thermocouple_z0p38', XYZ=8.4000,1.5000,0.3778, QUANTITY='THERMOCOUPLE', PROP_ID='TC' /
&DEVC ID='pt_temperature_z0p38', XYZ=8.4000,1.5000,0.3778, QUANTITY='TEMPERATURE' /
