! Grid-convergence T(z) lines (paper §3.3 Fig 5).  Each sensor emits TWO DEVCs:
!   '<id>'      = instantaneous T(z) at last dump time
!   '<id>_avg'  = TIME AVERAGE from t=100.0 s to T_END
&DEVC ID='gridconv_T_center', XB=8.4000,8.4000,2.5000,2.5000,0.0500,2.9500, POINTS=30, QUANTITY='TEMPERATURE', HIDE_COORDINATES=.TRUE. /  ! centre +1 m, z=[0.05, 2.95] -- instant
&DEVC ID='gridconv_T_center_avg', XB=8.4000,8.4000,2.5000,2.5000,0.0500,2.9500, POINTS=30, QUANTITY='TEMPERATURE', HIDE_COORDINATES=.TRUE., TEMPORAL_STATISTIC='TIME AVERAGE', STATISTICS_START=100.0 /  ! centre +1 m, z=[0.05, 2.95] -- time avg from 100.0s
&DEVC ID='gridconv_T_center_05m', XB=8.4000,8.4000,2.0000,2.0000,0.0500,2.9500, POINTS=30, QUANTITY='TEMPERATURE', HIDE_COORDINATES=.TRUE. /  ! centre +0.5 m, z=[0.05, 2.95] -- instant
&DEVC ID='gridconv_T_center_05m_avg', XB=8.4000,8.4000,2.0000,2.0000,0.0500,2.9500, POINTS=30, QUANTITY='TEMPERATURE', HIDE_COORDINATES=.TRUE., TEMPORAL_STATISTIC='TIME AVERAGE', STATISTICS_START=100.0 /  ! centre +0.5 m, z=[0.05, 2.95] -- time avg from 100.0s
&DEVC ID='gridconv_T_edge', XB=8.4000,8.4000,3.0000,3.0000,0.0500,1.9500, POINTS=30, QUANTITY='TEMPERATURE', HIDE_COORDINATES=.TRUE. /  ! edge   +1 m, z=[0.05, 1.95] -- instant
&DEVC ID='gridconv_T_edge_avg', XB=8.4000,8.4000,3.0000,3.0000,0.0500,1.9500, POINTS=30, QUANTITY='TEMPERATURE', HIDE_COORDINATES=.TRUE., TEMPORAL_STATISTIC='TIME AVERAGE', STATISTICS_START=100.0 /  ! edge   +1 m, z=[0.05, 1.95] -- time avg from 100.0s

