&DEVC ID='pt_volume_fraction_carbon_monoxide_z0p38', XYZ=8.4000,1.5000,0.3778, QUANTITY='VOLUME FRACTION', SPEC_ID='CARBON MONOXIDE' /
&DEVC ID='pt_volume_fraction_soot_z0p38', XYZ=8.4000,1.5000,0.3778, QUANTITY='VOLUME FRACTION', SPEC_ID='SOOT' /
&DEVC ID='pt_volume_fraction_oxygen_z0p38', XYZ=8.4000,1.5000,0.3778, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN' /
&DEVC ID='pt_thermocouple_z0p71', XYZ=8.4000,1.5000,0.7056, QUANTITY='THERMOCOUPLE', PROP_ID='TC' /
&DEVC ID='pt_temperature_z0p71', XYZ=8.4000,1.5000,0.7056, QUANTITY='TEMPERATURE' /
